<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
  
  <!-- ControlCentreServlet - User Registration -->
  <servlet>
    <servlet-name>ControlCentreServlet</servlet-name>
    <servlet-class>ControlCentreServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ControlCentreServlet</servlet-name>
    <url-pattern>/userRes</url-pattern>
  </servlet-mapping>
  
  <!-- LogInServlet - User Login -->
  <servlet>
    <servlet-name>LogInServlet</servlet-name>
    <servlet-class>LogInServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LogInServlet</servlet-name>
    <url-pattern>/SignIn</url-pattern>
  </servlet-mapping>
  
  <!-- PlayerCreditServlet - Credit Management -->
  <servlet>
    <servlet-name>PlayerCreditServlet</servlet-name>
    <servlet-class>PlayerCreditServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>PlayerCreditServlet</servlet-name>
    <url-pattern>/PlayerCreditServlet</url-pattern>
  </servlet-mapping>
  
</web-app>